{
  "name": "@tower1229/stella-fitness",
  "version": "0.1.0",
  "private": true,
  "description": "Recording-only OpenClaw Plugin for deterministic training-plan execution and observation capture",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tower1229/Stella-Fitness.git"
  },
  "homepage": "https://github.com/tower1229/Stella-Fitness#readme",
  "bugs": {
    "url": "https://github.com/tower1229/Stella-Fitness/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "LICENSE",
    "NOTICE",
    "COURSE-RIGHTS-NOTICE"
  ],
  "exports": {
    ".": "./dist/plugin.js",
    "./scenario": "./dist/scenario/harness.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-built-in-program.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:deterministic": "vitest run",
    "test:live-model": "node scripts/live-model-benchmark.mjs",
    "test:watch": "vitest",
    "verify:internal": "npm run typecheck && npm run test:deterministic && npm run build && npm run verify:package && npm run verify:clean-install",
    "verify:env": "node scripts/run-verification.mjs",
    "verify:network-install": "node scripts/verify-network-install.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "verify:clawhub": "node scripts/verify-clawhub.mjs",
    "verify:release": "npm run verify:env -- release"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.34"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/ws": "8.18.1",
    "clawhub": "0.23.3",
    "openclaw": "2026.6.34",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.34",
      "minGatewayVersion": "2026.6.34"
    },
    "build": {
      "openclawVersion": "2026.6.34",
      "pluginSdkVersion": "2026.6.34"
    }
  }
}
